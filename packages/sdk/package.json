{
  "name": "@vangrex/sdk",
  "version": "0.1.3",
  "description": "Official SDK for the Vangrex AI workflow platform",
  "license": "MIT",
  "author": "Mohammed Maaz",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vangrex": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflow-types": {
      "types": "./dist/workflow-types.d.ts",
      "import": "./dist/workflow-types.js"
    },
    "./workflow-contract": {
      "types": "./dist/workflow-contract.d.ts",
      "import": "./dist/workflow-contract.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Maaz2623/vangrex-v4.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Maaz2623/vangrex-v4",
  "bugs": {
    "url": "https://github.com/Maaz2623/vangrex-v4/issues"
  },
  "keywords": [
    "vangrex",
    "ai",
    "workflow",
    "automation",
    "sdk"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.0"
  }
}
